{
  "_comment": "Claude Code settings template. Sensitive values are placeholders — edit before use.",
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "YOUR_AUTH_TOKEN_HERE",
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
    "BASH_DEFAULT_TIMEOUT_MS": "3000000",
    "BASH_MAX_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "150000",
    "ENABLE_STREAMING": "true",
    "ENABLE_TOOL_SEARCH": "true",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "MAX_THINKING_TOKENS": "32000",
    "USE_BUILTIN_RIPGREP": "0",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/ninja-kit:~/.claude/mods/cache-guard"
  },
  "attribution": {
    "commit": "🥷 - from therealTINHTUTE with love",
    "pr": "from therealTINHTUTE with love ❤️"
  },
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/file-suggestion.sh"
  },
  "includeCoAuthoredBy": false,
  "model": "sonnet",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "teammateMode": "in-process",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "refreshInterval": 30
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {
    "diagram-design": {
      "source": {
        "source": "github",
        "repo": "cathrynlavery/diagram-design"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  }
}
